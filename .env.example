# ============================================================================
# Appwrite (legacy — still in use, will be removed at the end of the migration)
# ============================================================================
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT=your_project_id
VITE_APPWRITE_DATABASE_ID=your_database_id
VITE_APPWRITE_COLLECTION_BOOKINGS=your_bookings_collection_id
VITE_APPWRITE_COLLECTION_SHUTTLE_SLOTS=your_shuttle_slots_collection_id
VITE_APPWRITE_COLLECTION_RETURN_SLOTS=your_return_slots_collection_id
VITE_APPWRITE_COLLECTION_EVENTS=your_events_collection_id
VITE_APPWRITE_BUCKET_EVENTS=your_events_bucket_id
VITE_APPWRITE_COLLECTION_EVENT_PARTICIPATIONS=your_event_participations_collection_id
VITE_APPWRITE_FUNCTION_CREATE_BOOKING=your_create_booking_function_id
VITE_APPWRITE_FUNCTION_DELETE_ACCOUNT=your_delete_account_function_id
VITE_APPWRITE_FUNCTION_SEND_BOOKING_EMAIL=your_send_booking_email_function_id
APPWRITE_API_KEY=your_api_key_for_setup_script

# ============================================================================
# Supabase (external Supabase Cloud instance — NOT Lovable Cloud)
# ----------------------------------------------------------------------------
# Browser-safe: shipped in the Vite bundle. Anon key is public by design and
# must be protected only by Row Level Security in your Supabase project.
# ============================================================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ----------------------------------------------------------------------------
# Server-side only — NEVER prefix with VITE_ and NEVER import from src/.
# Configure these in Vercel → Project → Settings → Environment Variables
# (scope: Production / Preview / Development as needed). They are read by
# Supabase Edge Functions (Deno.env.get) and by one-off Node scripts.
# ----------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_keep_secret

# ============================================================================
# Resend — server-side only (Edge Functions / API routes). Calls the Resend
# REST API directly with your own account key. No connector gateway, no
# Lovable-managed credentials.
# ============================================================================
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL="StayUp <notify@your-domain.tld>"

# ============================================================================
# Public site URL — used to build absolute links in emails and OAuth redirects.
# This is a Vite app, so the VITE_ variant is what the browser bundle reads.
# Set VITE_SITE_URL in Vercel for every environment (e.g. https://stayup.app).
# ============================================================================
VITE_SITE_URL=http://localhost:5173
# Server-side mirror (optional) — same value, used by Edge Functions / scripts.
# SITE_URL=http://localhost:5173
